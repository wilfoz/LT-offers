# Copie para .env e ajuste conforme o ambiente local.
# O arquivo .env nunca é versionado (ver .gitignore).

# Banco de dados PostgreSQL local (docker-compose.yml)
POSTGRES_USER=lt_offers
POSTGRES_PASSWORD=lt_offers_dev
POSTGRES_DB=lt_offers
POSTGRES_PORT=5432

# String de conexão usada pelo Prisma (apps/api)
DATABASE_URL=postgresql://lt_offers:lt_offers_dev@localhost:5432/lt_offers

# Versão exibida no health check da api
APP_VERSAO=0.0.0
