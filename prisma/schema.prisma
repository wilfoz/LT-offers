// Schema Prisma do app api.
// Infra: health_check. Catálogos F1 seguem o padrão item + versões com
// vigência derivada (RNF-05): identidade estável e versões imutáveis, um par
// de modelos por nível de catálogo (catálogos hierárquicos têm mais de um
// nível; tabelas filhas pertencem à versão e são imutáveis com ela).
// As demais entidades de negócio (ofertas) chegam em fases futuras.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model HealthCheck {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  @@map("health_check")
}

// Catálogo de cabos condutores (piloto F1 — origem DB_CAL).
// Identidade e versões separadas: editar um item cria uma nova versão com
// vigência; versões existentes nunca são alteradas (RNF-05).
// Campos numéricos anuláveis: null = não informado, distinto de zero (RNF-09).
model ConductorCable {
  id       Int                     @id @default(autoincrement())
  code     String                  @unique
  versions ConductorCableVersion[]

  @@map("conductor_cable")
}

model ConductorCableVersion {
  id               Int            @id @default(autoincrement())
  conductorCableId Int            @map("conductor_cable_id")
  conductorCable   ConductorCable @relation(fields: [conductorCableId], references: [id])
  description      String?
  weightTonPerKm   Decimal?       @map("weight_ton_per_km") @db.Decimal(12, 4)
  reelLengthM      Decimal?       @map("reel_length_m") @db.Decimal(12, 2)
  diameterMm       Decimal?       @map("diameter_mm") @db.Decimal(10, 3)
  utsKn            Decimal?       @map("uts_kn") @db.Decimal(12, 2)
  effectiveFrom    DateTime       @map("effective_from") @db.Date
  createdBy        String         @map("created_by")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@unique([conductorCableId, effectiveFrom])
  @@index([conductorCableId, effectiveFrom(sort: Desc)])
  @@map("conductor_cable_version")
}

// Catálogo de cabos de guarda (F1 — origem DB_CGA e DB_OPGW).
// Família única com discriminador de tipo (design D1 da change
// catalogo-cabos-guarda-opgw): o tipo pertence à identidade e não muda entre
// versões. Colunas específicas de cada tipo são anuláveis; a aplicabilidade
// por tipo é garantida pela API (campo do outro tipo é rejeitado com 400).
enum GroundWireType {
  STEEL
  OPGW

  @@map("ground_wire_type")
}

model GroundWire {
  id       Int                 @id @default(autoincrement())
  code     String              @unique
  type     GroundWireType
  versions GroundWireVersion[]

  @@map("ground_wire")
}

model GroundWireVersion {
  id                 Int        @id @default(autoincrement())
  groundWireId       Int        @map("ground_wire_id")
  groundWire         GroundWire @relation(fields: [groundWireId], references: [id])
  description        String?
  weightTonPerKm     Decimal?   @map("weight_ton_per_km") @db.Decimal(12, 4)
  reelLengthM        Decimal?   @map("reel_length_m") @db.Decimal(12, 2)
  diameterMm         Decimal?   @map("diameter_mm") @db.Decimal(10, 3)
  utsKn              Decimal?   @map("uts_kn") @db.Decimal(12, 2)
  // Específicos do tipo aço (DB_CGA)
  galvanizationClass String?    @map("galvanization_class")
  strengthGrade      String?    @map("strength_grade")
  wireCount          Int?       @map("wire_count")
  // Específicos do tipo OPGW (DB_OPGW)
  manufacturer       String?
  i2tKa2s            Decimal?   @map("i2t_ka2s") @db.Decimal(12, 3)
  fiberCount         Int?       @map("fiber_count")
  effectiveFrom      DateTime   @map("effective_from") @db.Date
  createdBy          String     @map("created_by")
  createdAt          DateTime   @default(now()) @map("created_at")

  @@unique([groundWireId, effectiveFrom])
  @@index([groundWireId, effectiveFrom(sort: Desc)])
  @@map("ground_wire_version")
}

// Catálogo de cabos de aço para tirante (F1 — origem DB_CTI, tirantes e
// interligação). Catálogo próprio, sem discriminador de tipo (design D5 da
// change catalogo-cabos-tirante): a planilha consolida tirantes em aba
// separada e o RF-23 os quantifica à parte dos cabos de guarda.
model GuyWire {
  id       Int              @id @default(autoincrement())
  code     String           @unique
  versions GuyWireVersion[]

  @@map("guy_wire")
}

model GuyWireVersion {
  id                 Int      @id @default(autoincrement())
  guyWireId          Int      @map("guy_wire_id")
  guyWire            GuyWire  @relation(fields: [guyWireId], references: [id])
  description        String?
  weightTonPerKm     Decimal? @map("weight_ton_per_km") @db.Decimal(12, 4)
  reelLengthM        Decimal? @map("reel_length_m") @db.Decimal(12, 2)
  diameterMm         Decimal? @map("diameter_mm") @db.Decimal(10, 3)
  utsKn              Decimal? @map("uts_kn") @db.Decimal(12, 2)
  galvanizationClass String?  @map("galvanization_class")
  strengthGrade      String?  @map("strength_grade")
  wireCount          Int?     @map("wire_count")
  effectiveFrom      DateTime @map("effective_from") @db.Date
  createdBy          String   @map("created_by")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([guyWireId, effectiveFrom])
  @@index([guyWireId, effectiveFrom(sort: Desc)])
  @@map("guy_wire_version")
}

// Catálogo de séries de estruturas e torres (F1 — origem DB_TOR), primeiro
// catálogo hierárquico (design D1 da change catalogo-series-torres): série →
// tipos de torre, cada nível no padrão item + versões. A função do tipo de
// torre pertence à identidade (como GroundWire.type) e não muda entre versões;
// a tabela peso × altura pertence à versão e é imutável junto com ela.
model StructureSeries {
  id         Int                      @id @default(autoincrement())
  name       String                   @unique
  versions   StructureSeriesVersion[]
  towerTypes TowerType[]

  @@map("structure_series")
}

model StructureSeriesVersion {
  id                Int             @id @default(autoincrement())
  structureSeriesId Int             @map("structure_series_id")
  structureSeries   StructureSeries @relation(fields: [structureSeriesId], references: [id])
  designer          String?
  voltageKv         Decimal?        @map("voltage_kv") @db.Decimal(12, 2)
  circuitCount      Int?            @map("circuit_count")
  cablesPerPhase    Int?            @map("cables_per_phase")
  designWindSpeedMs Decimal?        @map("design_wind_speed_ms") @db.Decimal(12, 2)
  insulatorType     String?         @map("insulator_type")
  silMw             Decimal?        @map("sil_mw") @db.Decimal(12, 2)
  effectiveFrom     DateTime        @map("effective_from") @db.Date
  createdBy         String          @map("created_by")
  createdAt         DateTime        @default(now()) @map("created_at")

  @@unique([structureSeriesId, effectiveFrom])
  @@index([structureSeriesId, effectiveFrom(sort: Desc)])
  @@map("structure_series_version")
}

enum TowerFunction {
  SUSPENSION
  ANCHOR

  @@map("tower_function")
}

model TowerType {
  id                Int                @id @default(autoincrement())
  structureSeriesId Int                @map("structure_series_id")
  structureSeries   StructureSeries    @relation(fields: [structureSeriesId], references: [id])
  code              String
  function          TowerFunction
  versions          TowerTypeVersion[]
  volumes           FoundationVolume[]

  @@unique([structureSeriesId, code])
  @@map("tower_type")
}

model TowerTypeVersion {
  id            Int               @id @default(autoincrement())
  towerTypeId   Int               @map("tower_type_id")
  towerType     TowerType         @relation(fields: [towerTypeId], references: [id])
  guyCount      Int?              @map("guy_count")
  weights       TowerTypeWeight[]
  effectiveFrom DateTime          @map("effective_from") @db.Date
  createdBy     String            @map("created_by")
  createdAt     DateTime          @default(now()) @map("created_at")

  @@unique([towerTypeId, effectiveFrom])
  @@index([towerTypeId, effectiveFrom(sort: Desc)])
  @@map("tower_type_version")
}

model TowerTypeWeight {
  id                 Int              @id @default(autoincrement())
  towerTypeVersionId Int              @map("tower_type_version_id")
  towerTypeVersion   TowerTypeVersion @relation(fields: [towerTypeVersionId], references: [id])
  heightM            Decimal          @map("height_m") @db.Decimal(10, 3)
  weightKg           Decimal          @map("weight_kg") @db.Decimal(12, 2)

  @@unique([towerTypeVersionId, heightM])
  @@map("tower_type_weight")
}

// Catálogo de isoladores (F1 — origem DB_AIS). Catálogo plano, sem
// discriminador (design D1 da change catalogo-isoladores): o levantamento não
// enumera valores de tipo/perfil, então ambos são texto livre na versão.
model Insulator {
  id       Int                @id @default(autoincrement())
  code     String             @unique
  versions InsulatorVersion[]

  @@map("insulator")
}

model InsulatorVersion {
  id                 Int       @id @default(autoincrement())
  insulatorId        Int       @map("insulator_id")
  insulator          Insulator @relation(fields: [insulatorId], references: [id])
  description        String?
  type               String?
  manufacturer       String?
  profile            String?
  ruptureStrengthKn  Decimal?  @map("rupture_strength_kn") @db.Decimal(12, 2)
  diameterMm         Decimal?  @map("diameter_mm") @db.Decimal(10, 3)
  spacingMm          Decimal?  @map("spacing_mm") @db.Decimal(10, 3)
  creepageDistanceMm Decimal?  @map("creepage_distance_mm") @db.Decimal(10, 3)
  effectiveFrom      DateTime  @map("effective_from") @db.Date
  createdBy          String    @map("created_by")
  createdAt          DateTime  @default(now()) @map("created_at")

  @@unique([insulatorId, effectiveFrom])
  @@index([insulatorId, effectiveFrom(sort: Desc)])
  @@map("insulator_version")
}

// Catálogo de solos e fundações (F1 — origem DB_FUN), três recursos (design D1
// da change catalogo-solos-fundacoes): tipos de solo, tipos de fundação (com
// aplicação na identidade, como GroundWire.type) e a matriz de volumes por
// combinação torre × solo × fundação (RN-13) — identidade composta pela tripla
// de FKs, única no banco; as quantidades ficam na versão. Nomes de índice da
// matriz são explícitos: os auto-gerados passariam do limite de 63 caracteres
// do Postgres (NAMEDATALEN) e seriam truncados em silêncio.
model SoilType {
  id       Int                @id @default(autoincrement())
  code     String             @unique
  versions SoilTypeVersion[]
  volumes  FoundationVolume[]

  @@map("soil_type")
}

model SoilTypeVersion {
  id                               Int      @id @default(autoincrement())
  soilTypeId                       Int      @map("soil_type_id")
  soilType                         SoilType @relation(fields: [soilTypeId], references: [id])
  description                      String?
  submerged                        Boolean?
  allowableCompressionStressKgfCm2 Decimal? @map("allowable_compression_stress_kgf_cm2") @db.Decimal(12, 2)
  specificWeightKgfM3              Decimal? @map("specific_weight_kgf_m3") @db.Decimal(12, 2)
  internalFrictionAngleDeg         Decimal? @map("internal_friction_angle_deg") @db.Decimal(10, 3)
  cohesionKgCm2                    Decimal? @map("cohesion_kg_cm2") @db.Decimal(10, 3)
  // Faixa de NSPT: mínimo inclusivo, máximo exclusivo (x≤N<y na planilha);
  // mínimo < máximo é garantido na API, sem CHECK no banco (risco aceito).
  nsptMin                          Int?     @map("nspt_min")
  nsptMax                          Int?     @map("nspt_max")
  effectiveFrom                    DateTime @map("effective_from") @db.Date
  createdBy                        String   @map("created_by")
  createdAt                        DateTime @default(now()) @map("created_at")

  @@unique([soilTypeId, effectiveFrom])
  @@index([soilTypeId, effectiveFrom(sort: Desc)])
  @@map("soil_type_version")
}

enum FoundationApplication {
  SELF_SUPPORTING
  GUYED
  CROSS_ROPE

  @@map("foundation_application")
}

model FoundationType {
  id          Int                     @id @default(autoincrement())
  code        String                  @unique
  application FoundationApplication
  versions    FoundationTypeVersion[]
  volumes     FoundationVolume[]

  @@map("foundation_type")
}

model FoundationTypeVersion {
  id                       Int            @id @default(autoincrement())
  foundationTypeId         Int            @map("foundation_type_id")
  foundationType           FoundationType @relation(fields: [foundationTypeId], references: [id])
  description              String?
  // Composição por elemento de fundação: contagens ≥ 0 anuláveis (null = não
  // informado, distinto de zero — RNF-09), espelhando as 17 colunas da DB_FUN.
  spreadFootingCount       Int?           @map("spread_footing_count")
  precastMastCount         Int?           @map("precast_mast_count")
  precastGuyCount          Int?           @map("precast_guy_count")
  straightPierCount        Int?           @map("straight_pier_count")
  belledPierCount          Int?           @map("belled_pier_count")
  slabPierCount            Int?           @map("slab_pier_count")
  straightPierGuyCount     Int?           @map("straight_pier_guy_count")
  belledPierGuyCount       Int?           @map("belled_pier_guy_count")
  rockAnchorCount          Int?           @map("rock_anchor_count")
  concretePileCount        Int?           @map("concrete_pile_count")
  steelPileCount           Int?           @map("steel_pile_count")
  helicalMastCount         Int?           @map("helical_mast_count")
  helicalGuyCount          Int?           @map("helical_guy_count")
  triconeCount             Int?           @map("tricone_count")
  rootPileCount            Int?           @map("root_pile_count")
  micropileCount           Int?           @map("micropile_count")
  continuousAugerPileCount Int?           @map("continuous_auger_pile_count")
  effectiveFrom            DateTime       @map("effective_from") @db.Date
  createdBy                String         @map("created_by")
  createdAt                DateTime       @default(now()) @map("created_at")

  @@unique([foundationTypeId, effectiveFrom])
  @@index([foundationTypeId, effectiveFrom(sort: Desc)])
  @@map("foundation_type_version")
}

model FoundationVolume {
  id               Int                       @id @default(autoincrement())
  towerTypeId      Int                       @map("tower_type_id")
  towerType        TowerType                 @relation(fields: [towerTypeId], references: [id])
  soilTypeId       Int                       @map("soil_type_id")
  soilType         SoilType                  @relation(fields: [soilTypeId], references: [id])
  foundationTypeId Int                       @map("foundation_type_id")
  foundationType   FoundationType            @relation(fields: [foundationTypeId], references: [id])
  versions         FoundationVolumeVersion[]

  @@unique([towerTypeId, soilTypeId, foundationTypeId], map: "foundation_volume_tower_soil_foundation_key")
  @@map("foundation_volume")
}

model FoundationVolumeVersion {
  id                        Int              @id @default(autoincrement())
  foundationVolumeId        Int              @map("foundation_volume_id")
  foundationVolume          FoundationVolume @relation(fields: [foundationVolumeId], references: [id])
  // Quantidades da combinação (~34 colunas da DB_FUN), decimais ≥ 0 anuláveis
  // (RNF-09). Unidades inferidas — hipótese registrada no proposal (§02).
  excavationHardFootingM3   Decimal?         @map("excavation_hard_footing_m3") @db.Decimal(12, 3)
  excavationNormalFootingM3 Decimal?         @map("excavation_normal_footing_m3") @db.Decimal(12, 3)
  excavationWaterFootingM3  Decimal?         @map("excavation_water_footing_m3") @db.Decimal(12, 3)
  excavationHardPrecastM3   Decimal?         @map("excavation_hard_precast_m3") @db.Decimal(12, 3)
  excavationNormalPrecastM3 Decimal?         @map("excavation_normal_precast_m3") @db.Decimal(12, 3)
  excavationWaterPrecastM3  Decimal?         @map("excavation_water_precast_m3") @db.Decimal(12, 3)
  excavationHardPileCapM3   Decimal?         @map("excavation_hard_pile_cap_m3") @db.Decimal(12, 3)
  excavationNormalPileCapM3 Decimal?         @map("excavation_normal_pile_cap_m3") @db.Decimal(12, 3)
  excavationWaterPileCapM3  Decimal?         @map("excavation_water_pile_cap_m3") @db.Decimal(12, 3)
  excavationPierM3          Decimal?         @map("excavation_pier_m3") @db.Decimal(12, 3)
  anchorBoltDrillingM       Decimal?         @map("anchor_bolt_drilling_m") @db.Decimal(12, 3)
  steelPiersKg              Decimal?         @map("steel_piers_kg") @db.Decimal(12, 3)
  steelFootingsKg           Decimal?         @map("steel_footings_kg") @db.Decimal(12, 3)
  steelPileCapsKg           Decimal?         @map("steel_pile_caps_kg") @db.Decimal(12, 3)
  steelPrecastKg            Decimal?         @map("steel_precast_kg") @db.Decimal(12, 3)
  steelRockKg               Decimal?         @map("steel_rock_kg") @db.Decimal(12, 3)
  steelAnchorBoltsKg        Decimal?         @map("steel_anchor_bolts_kg") @db.Decimal(12, 3)
  concretePiersM3           Decimal?         @map("concrete_piers_m3") @db.Decimal(12, 3)
  concreteFootingsM3        Decimal?         @map("concrete_footings_m3") @db.Decimal(12, 3)
  concretePileCapsM3        Decimal?         @map("concrete_pile_caps_m3") @db.Decimal(12, 3)
  concretePrecastM3         Decimal?         @map("concrete_precast_m3") @db.Decimal(12, 3)
  concreteRockM3            Decimal?         @map("concrete_rock_m3") @db.Decimal(12, 3)
  regenerationM3            Decimal?         @map("regeneration_m3") @db.Decimal(12, 3)
  groutM3                   Decimal?         @map("grout_m3") @db.Decimal(12, 3)
  backfillSoilM3            Decimal?         @map("backfill_soil_m3") @db.Decimal(12, 3)
  backfillSoilCementM3      Decimal?         @map("backfill_soil_cement_m3") @db.Decimal(12, 3)
  formworkM2                Decimal?         @map("formwork_m2") @db.Decimal(12, 3)
  helicalPileM              Decimal?         @map("helical_pile_m") @db.Decimal(12, 3)
  steelPileM                Decimal?         @map("steel_pile_m") @db.Decimal(12, 3)
  triconeM                  Decimal?         @map("tricone_m") @db.Decimal(12, 3)
  rootPileM                 Decimal?         @map("root_pile_m") @db.Decimal(12, 3)
  continuousAugerPileM      Decimal?         @map("continuous_auger_pile_m") @db.Decimal(12, 3)
  micropileM                Decimal?         @map("micropile_m") @db.Decimal(12, 3)
  concretePileM             Decimal?         @map("concrete_pile_m") @db.Decimal(12, 3)
  effectiveFrom             DateTime         @map("effective_from") @db.Date
  createdBy                 String           @map("created_by")
  createdAt                 DateTime         @default(now()) @map("created_at")

  @@unique([foundationVolumeId, effectiveFrom], map: "foundation_volume_version_volume_id_effective_from_key")
  @@index([foundationVolumeId, effectiveFrom(sort: Desc)], map: "foundation_volume_version_volume_id_effective_from_idx")
  @@map("foundation_volume_version")
}

// Catálogo de mão de obra (F1 — origem DB_MO, RF-12, RN-14).
model LaborRole {
  id       Int                @id @default(autoincrement())
  code     String             @unique
  name     String
  versions LaborRoleVersion[]

  @@map("labor_role")
}

model LaborRoleVersion {
  id                     Int       @id @default(autoincrement())
  laborRoleId            Int       @map("labor_role_id")
  laborRole              LaborRole @relation(fields: [laborRoleId], references: [id])
  baseSalary             Decimal?  @map("base_salary") @db.Decimal(12, 2)
  hazardPayPercent       Decimal?  @map("hazard_pay_percent") @db.Decimal(6, 4)
  overtimePercent        Decimal?  @map("overtime_percent") @db.Decimal(6, 4)
  dsrOvertimePercent     Decimal?  @map("dsr_overtime_percent") @db.Decimal(6, 4)
  socialChargesPercent   Decimal?  @map("social_charges_percent") @db.Decimal(6, 4)
  foodAllowanceMonthly   Decimal?  @map("food_allowance_monthly") @db.Decimal(12, 2)
  housingMonthly         Decimal?  @map("housing_monthly") @db.Decimal(12, 2)
  homeLeaveTravelMonthly Decimal?  @map("home_leave_travel_monthly") @db.Decimal(12, 2)
  healthInsuranceMonthly Decimal?  @map("health_insurance_monthly") @db.Decimal(12, 2)
  lifeInsuranceMonthly   Decimal?  @map("life_insurance_monthly") @db.Decimal(12, 2)
  effectiveFrom          DateTime  @map("effective_from") @db.Date
  createdBy              String    @map("created_by")
  createdAt              DateTime  @default(now()) @map("created_at")

  @@unique([laborRoleId, effectiveFrom])
  @@index([laborRoleId, effectiveFrom(sort: Desc)])
  @@map("labor_role_version")
}

// Catálogo de equipamentos (F1 — origem DB_EQ, RF-13, RN-17).
model Equipment {
  id          Int                @id @default(autoincrement())
  code        String             @unique
  description String
  category    String?
  versions    EquipmentVersion[]

  @@map("equipment")
}

model EquipmentVersion {
  id                     Int       @id @default(autoincrement())
  equipmentId            Int       @map("equipment_id")
  equipment              Equipment @relation(fields: [equipmentId], references: [id])
  externalRentalMonthly  Decimal?  @map("external_rental_monthly") @db.Decimal(12, 2)
  internalRentalMonthly  Decimal?  @map("internal_rental_monthly") @db.Decimal(12, 2)
  purchasePrice          Decimal?  @map("purchase_price") @db.Decimal(12, 2)
  depreciationYears      Int?      @map("depreciation_years")
  ownedAvailabilityCount Int?      @map("owned_availability_count")
  fuelMaintenanceMonthly Decimal?  @map("fuel_maintenance_monthly") @db.Decimal(12, 2)
  effectiveFrom          DateTime  @map("effective_from") @db.Date
  createdBy              String    @map("created_by")
  createdAt              DateTime  @default(now()) @map("created_at")

  @@unique([equipmentId, effectiveFrom])
  @@index([equipmentId, effectiveFrom(sort: Desc)])
  @@map("equipment_version")
}

// Catálogo de custos fixos e indiretos (F1 — origem DB_FI).
enum FixedCostCategory {
  EPI
  MEDICAL_EXAM
  UNIFORM
  MOB_DEMOB
  TRAVEL_HOUSING
  OTHER

  @@map("fixed_cost_category")
}

model FixedCost {
  id          Int                @id @default(autoincrement())
  code        String             @unique
  description String
  category    FixedCostCategory
  versions    FixedCostVersion[]

  @@map("fixed_cost")
}

model FixedCostVersion {
  id            Int       @id @default(autoincrement())
  fixedCostId   Int       @map("fixed_cost_id")
  fixedCost     FixedCost @relation(fields: [fixedCostId], references: [id])
  unitCost      Decimal?  @map("unit_cost") @db.Decimal(12, 2)
  unit          String?   @db.VarChar(50)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  createdBy     String    @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([fixedCostId, effectiveFrom])
  @@index([fixedCostId, effectiveFrom(sort: Desc)])
  @@map("fixed_cost_version")
}
